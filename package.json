{
  "name": "ext267",
  "version": "1.1.1",
  "description": "A multipurpose, extensible browser toolkit. Capture download requests and generate CLI commands for curl, wget, and aria2c.",
  "scripts": {
    "lint": "web-ext lint",
    "lint:js": "eslint .",
    "test": "node --test",
    "test:e2e": "node tests/e2e/e2e.mjs",
    "verify": "npm test && npm run lint && npm run lint:js",
    "check:version": "node tools/amo-version-check.js",
    "dev": "web-ext run",
    "build": "node build-package.js",
    "version": "node version-sync.js && git add manifest.json",
    "package:xpi": "node build-package.js"
  },
  "author": "dat <dat267@outlook.com>",
  "license": "MPL-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "web-ext": "*"
  },
  "webExt": {
    "ignoreFiles": [
      "package-lock.json",
      "AGENTS.md",
      "README.md",
      "RELEASE.md",
      "eslint.config.mjs",
      "build-package.js",
      "version-sync.js",
      "amo-metadata.json",
      "tests/**",
      "tools/**",
      "plugins/plugin-template.js",
      ".github/**"
    ]
  }
}
